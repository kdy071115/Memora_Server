# ===========================================
# Memora Server - 환경 변수 예시 파일
# 실제 사용시 .env 로 복사해서 값 채우기
#   cp .env.example .env
# ===========================================

# ====== Database (PostgreSQL) ======
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/memora
DB_USERNAME=memora
DB_PASSWORD=memora

# ====== JWT ======
# 운영 환경에서는 반드시 256bit 이상의 강력한 랜덤 값으로 변경
JWT_SECRET=asdasdjsdufjrl3kj983elfnalsfnlskfdasdjalkfbsdlghslkfsdaaskdnalsdnalsdkjaldsadgewerqwe2tw

# ====== AI Server (FastAPI) ======
AI_SERVER_URL=http://localhost:8000

# ====== CORS ======
# 콤마 구분, 와일드카드(*) 지원
# 예) http://localhost:3000,https://*.vercel.app,https://memora-frontend.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ====== AWS S3 ======
# 빈 값으로 두면 자동으로 로컬 디스크(./uploads)에 저장됩니다.
# 실제 S3 사용 시에만 키를 채우세요.
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=memora-uploads

# ====== Local Storage Fallback ======
# AWS 키가 비어 있을 때 사용할 로컬 저장 경로 (절대/상대 모두 가능)
STORAGE_LOCAL_PATH=./uploads
