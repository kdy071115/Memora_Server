# ===========================================
# Memora Server - 환경 변수 예시 파일
# 실제 사용시 .env 로 복사해서 값 채우기
#   cp .env.example .env
# ===========================================

# ====== Database (PostgreSQL) ======
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/memora
DB_USERNAME=memora
DB_PASSWORD=memora

# ====== JWT ======
# 운영 환경에서는 반드시 256bit 이상의 강력한 랜덤 값으로 변경
JWT_SECRET=asdasdjsdufjrl3kj983elfnalsfnlskfdasdjalkfbsdlghslkfsdaaskdnalsdnalsdkjaldsadgewerqwe2tw

# ====== AI Server (FastAPI) ======
AI_SERVER_URL=http://localhost:8000

# ====== AWS S3 ======
# 로컬 개발 중 S3 미사용 시 빈 값으로 두면 업로드 기능만 비활성화됨
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=memora-uploads
